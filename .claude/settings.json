{
  "permissions": {
    "allow": [
      "Bash(./scripts/check.sh)",
      "Bash(make *)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(git status*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs:*)",
      "Bash(pre-commit run:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)"
    ]
  }
}
