# Copy file này thành .env rồi đổi mật khẩu:  cp .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore).

ENVIRONMENT=local
LOG_LEVEL=INFO
NGINX_PORT=8080

# Tài khoản quản trị Postgres, chỉ dùng để khởi tạo database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# Mỗi service có user + mật khẩu DB riêng (ADR-0002).
BOOKING_DB_PASSWORD=change-me-booking
ROOM_DB_PASSWORD=change-me-room

# RabbitMQ — dùng management UI tại http://localhost:15672 khi local
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MGMT_PORT=15672

# Auth0 — xem docs/auth0-setup.md để biết cách lấy các giá trị này
# Domain: dạng <tenant>.auth0.com (lấy từ Auth0 Dashboard → Settings)
AUTH0_DOMAIN=your-tenant.auth0.com
# Audience: identifier của API bạn tạo trong Auth0 (vd: https://mrms.api)
AUTH0_AUDIENCE=https://mrms.api
# Client ID + Secret: lấy từ "Machine to Machine" application (dùng khi test lấy token)
AUTH0_M2M_CLIENT_ID=change-me
AUTH0_M2M_CLIENT_SECRET=change-me
