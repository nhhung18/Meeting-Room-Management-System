# Copy file này thành .env rồi đổi mật khẩu:  cp .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore).

ENVIRONMENT=local
LOG_LEVEL=INFO
NGINX_PORT=8080

# Tài khoản quản trị Postgres, chỉ dùng để khởi tạo database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# Mỗi service có user + mật khẩu DB riêng (ADR-0002).
BOOKING_DB_PASSWORD=change-me-booking
ROOM_DB_PASSWORD=change-me-room
